{
  "version": "2.0",
  "extensions": {
    "serviceBus": {
      "clientRetryOptions": {
        "mode": "Fixed",
        "tryTimeout": "00:00:50",
        "delay": "00:00:30",
        "maxDelay": "00:01:00",
        "maxRetries": 2
      },
      "maxConcurrentCalls": 4,
      "maxConcurrentSessions": 1
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  }
}