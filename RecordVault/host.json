{
  "version": "2.0",
  "extensions": {
    "serviceBus": {
      "maxConcurrentCalls": 2,
      "maxConcurrentSessions": 2
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  }
}